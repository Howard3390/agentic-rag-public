# Copy this file to .env. Fill values with paths and credentials on your own machine.
# Do not commit .env. Paths may be absolute; quote values that contain spaces.

# Existing LightRAG checkout and its separate Python environment
LIGHTRAG_SOURCE_DIR=
LIGHTRAG_PYTHON=
# Parent directory containing hotpotqa/index, 2wikimultihopqa/index, musique/index
LIGHTRAG_INDEX_ROOT=
# Existing LightRAG embedding settings file (EMBEDDING_* values)
LIGHTRAG_ENV_FILE=

# Existing LinearRAG checkout and its separate Python environment
LINEARRAG_ROOT=
LINEARRAG_PYTHON=
# Optional: defaults to cache/linearrag inside this project
LINEARRAG_CACHE_DIR=

# OpenAI-compatible answer model; used for Judge and answer generation
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Optional retrieval limits
LIGHTRAG_CHUNK_TOP_K=10
LIGHTRAG_MAX_TOTAL_TOKENS=20000
LINEARRAG_TOP_K=10
LIGHTRAG_LOCAL_TOP_K=40
LIGHTRAG_LOCAL_CHUNK_TOP_K=10
LIGHTRAG_LOCAL_MAX_TOTAL_TOKENS=30000
